# ExtendedTimetable settings, read by extt.service, extt-backup.service and
# exttctl. install.sh creates /etc/extt/extt.env from this file once and
# never overwrites it. Run `extt help` for every option.

EXTT_DB=/var/lib/extt/extt.db
# nginx proxies to this address; keep it on loopback.
EXTT_ADDR=127.0.0.1:8080
# nginx sets X-Real-IP, which the login rate limit needs.
EXTT_TRUST_PROXY=true
# Secure cookies need HTTPS. Set to false only while the site is served over
# plain HTTP (no domain or certificate yet).
EXTT_SECURE_COOKIES=true
# The site's address, for full invite links (the leader's page and
# `exttctl admin invite-link`). install.sh fills it in from the server name;
# change it if the site moves (e.g. behind a Cloudflare Tunnel on a domain).
EXTT_BASE_URL=
# The site's time zone: classes run on it, and users who have not picked a
# zone and whose browser does not report one see dates in it.
EXTT_TZ=Europe/Kyiv
EXTT_CIST_INTERVAL=6h
# YouTube Data API key: recordings are synced from each group's playlist
# (set on the Recordings page) every EXTT_YOUTUBE_INTERVAL. Empty: off.
# docs/deploy.md says how to get one.
EXTT_YOUTUBE_KEY=
EXTT_YOUTUBE_INTERVAL=1h
# Logs go to journald (journalctl -u extt). Level: debug, info, warn or error
# (debug only while chasing a bug). Format: text to read, json for a collector.
EXTT_LOG_LEVEL=info
EXTT_LOG_FORMAT=text
# Prometheus metrics at /metrics on a separate address (empty: off).
# deploy/monitoring.sh sets it to 127.0.0.1:9101; keep it on loopback, since
# nginx does not and must not proxy it.
EXTT_METRICS_ADDR=

# The Go runtime's memory: extt.service sets GOGC=200 and GOMEMLIMIT=150MiB,
# which suit a small machine. On one with less than 512 MB of RAM, lower the
# limit, e.g. GOMEMLIMIT=100MiB.
#GOMEMLIMIT=150MiB

# Backups (backup.sh)
BACKUP_DIR=/var/backups/extt
KEEP_DAYS=14
